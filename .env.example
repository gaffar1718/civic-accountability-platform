# ============================================================
# Environment Variables — India Civic Accountability Platform
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ============================================================

# Cloudflare Turnstile (bot-proof CAPTCHA)
# Get yours free at: https://dash.cloudflare.com/turnstile
# Use the "Invisible" widget type for best UX.
# The test key below passes all Turnstile checks in dev only:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: analytics (Plausible, Umami — both free & privacy-safe)
# VITE_PLAUSIBLE_DOMAIN=india-civic-accountability.netlify.app
